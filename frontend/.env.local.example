# =============================================================================
# Build Configuration
# =============================================================================
# Brand selection for reference ("seb" or "warp"). Vite config reads
# process.env.BRAND: export BRAND or use BRAND=warp npm run build.
# Setting only this file does not select all build-time branding.
BRAND=warp

# =============================================================================
# Playwright Test Configuration
# =============================================================================
# Full browser URL, including the HTTPS port if needed
TEST_DOMAIN=https://host:8081

# Optional CHARGER relay port override (e.g., ":8081").
# This is NOT appended to TEST_DOMAIN for browser navigation.
TEST_PORT=:8081

# First test user credentials (used for login and primary test operations)
TEST_USER_NAME1=TestUser1
TEST_PASSWORD1=TestPassword1

# Second test user credentials (used for multi-user tests like email change)
TEST_USER_NAME2=TestUser2
TEST_PASSWORD2=TestPassword2

# =============================================================================
# Wallbox/Charger Integration Tests (Optional)
# =============================================================================
# These are required for charger lifecycle tests. Skip if not testing charger integration.

# Wallbox domain - URL of the test wallbox/charger
TEST_WALLBOX_DOMAIN=http://warp3-xxxx.localdomain

# Wallbox UID - Unique identifier of the test charger
TEST_WALLBOX_UID=xxxx

# Set to "true" if using a custom/self-signed TLS certificate
NEED_CUSTOM_CERT=true

# =============================================================================
# Mailisk Email Testing (Optional)
# =============================================================================
# Required for the full npm test lifecycle (account creation/verification/deletion)
# and authenticated account tests. Unit tests do not use Mailisk.

# Mailisk API key for email inbox access
MAILISK_API_KEY=your_api_key

# Mailisk namespace (forms email domain: user@namespace.mailisk.net)
MAILISK_NAMESPACE=your_namespace

# Test users for email testing (without @domain suffix)
MAILISK_USER1=user1
MAILISK_USER2=user2

# =============================================================================
# Node.js SSL Configuration (Optional)
# =============================================================================
# Path to custom CA certificate for self-signed certificates
NODE_EXTRA_CA_CERTS=/path/to/rootCA.pem
