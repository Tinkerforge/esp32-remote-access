{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npx playwright test --project=chromium -c pre-playwright.config.ts",
    "test": "npx playwright test --project=chromium",
    "posttest": "npx playwright test --project=chromium -c post-playwright.config.ts",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "build:wasm": "cd ../wg-webclient && wasm-pack build --target web",
    "typecheck": "npm run build:wasm && tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "argon2-browser": "^1.18.0",
    "base58": "^2.0.1",
    "bootstrap": "^5.3.8",
    "esbuild": "^0.28.2",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "i18next-http-backend": "^4.0.6",
    "js-base64": "^3.9.4",
    "libsodium-wrappers": "^0.8.4",
    "median-js-bridge": "^2.21.0",
    "openapi-fetch": "^0.17.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.1",
    "react-bootstrap": "^2.10.10",
    "react-feather": "^2.0.10",
    "react-i18next": "^17.1.9",
    "wg-webclient": "file:../wg-webclient/pkg",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "@types/argon2-browser": "^1.18.4",
    "@types/base58": "^2.0.0",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "dotenv": "^18.0.9",
    "jsdom": "^30.1.3",
    "mailisk": "^2.5.2",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "sass": "^1.106.1",
    "uuid": "^14.0.3",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "mailisk": {
      "nodemailer": "^10.0.9"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
