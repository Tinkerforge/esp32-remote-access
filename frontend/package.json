{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npx playwright test --project=chromium -c pre-playwright.config.ts",
    "test": "npx playwright test --project=chromium",
    "posttest": "npx playwright test --project=chromium -c post-playwright.config.ts",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "build:wasm": "cd ../wg-webclient && wasm-pack build --target web",
    "typecheck": "npm run build:wasm && tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@preact/signals": "^2",
    "argon2-browser": "^1.18.0",
    "base58": "^2.0.1",
    "bootstrap": "^5.3.6",
    "esbuild": "^0.28.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-http-backend": "^4.0.4",
    "js-base64": "^3.7.7",
    "libsodium-wrappers": "^0.8.4",
    "median-js-bridge": "^2.11.0",
    "openapi-fetch": "^0.13",
    "preact": "^10.28.2",
    "preact-iso": "^2",
    "preact-render-to-string": "^6",
    "react-bootstrap": "^2.10.10",
    "react-feather": "^2.0.10",
    "react-i18next": "^15.4.1",
    "wg-webclient": "file:../wg-webclient/pkg",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/argon2-browser": "^1.18.4",
    "@types/base58": "^2.0.0",
    "@types/node": "^24",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "dotenv": "^16.4.5",
    "jsdom": "^26.1.0",
    "mailisk": "^2.0.0",
    "oxlint": "^1.85.0",
    "postcss": ">=8.5.23",
    "sass": "1",
    "uuid": "^14.0.0",
    "vite": ">=8.0.16",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "mailisk": {
      "nodemailer": "^10.0.9"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@parcel/watcher@2.5.6": true
  }
}
