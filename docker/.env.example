# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================

# Password for the PostgreSQL database user
# Example: my_secure_password_123
PG_PASS=

# Name of the PostgreSQL database to create/use
# Example: remote_access
POSTGRES_DB=

# PostgreSQL database username
# Example: postgres
POSTGRES_USER=

# =============================================================================
# Docker Image Configuration
# =============================================================================

# Docker image tag for the backend container
# Use the base tag WITHOUT a brand suffix; Compose appends -${BRAND}.
# Example: latest, v1.0.0
IMAGE_TAG=

# =============================================================================
# Backend Application Configuration
# =============================================================================

# Full PostgreSQL connection URL used by the backend
# Format: postgres://<user>:<password>@<host>/<database>
# Example: postgres://postgres:my_password@postgres/remote_access
DATABASE_URL=

# Secret key used for signing JWT (JSON Web Tokens) for authentication
# Should be a long, random, secure string
# Example: your_super_secret_jwt_key_here_make_it_long_and_random
JWT_SECRET=

# Pre-shared authorization token string served by the /api/auth/service_token
# endpoint. Leave empty to disable the endpoint (it will return 500).
# Example: my-long-random-service-token-string
OPTIONAL_SERVICE_AUTH_TOKEN=

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================

# SMTP username for sending emails (verification, recovery, notifications)
# Example: noreply@example.com
EMAIL_USER=

# SMTP password for the email user
# Example: your_email_password
EMAIL_PASS=

# SMTP relay server hostname
# Example: mail.example.com or smtp.gmail.com
EMAIL_RELAY=

# SMTP relay port. The backend uses implicit TLS via SmtpTransport::relay,
# not STARTTLS/plaintext selected by port. Usually 465.
# Example: 465
EMAIL_RELAY_PORT=

# =============================================================================
# Application URLs and Sender Information
# =============================================================================

# Base URL of the frontend application (used in email links)
# Example: https://my-remote-access.example.com
FRONTEND_URL=

# Email address shown as the sender in outgoing emails
# Example: noreply@example.com
SENDER_EMAIL=

# Display name shown as the sender in outgoing emails
# Example: WARP Remote Access
SENDER_NAME=

# Human-readable server name used in monitoring emails and logs
# Example: Production Server
SERVER_NAME=

# Email address to receive daily user/device-count reports
# The backend enables monitoring when both SERVER_NAME and MONITORING_EMAIL
# are present, even if empty. Compose always passes both; see operations.md.
# Example: admin@example.com
MONITORING_EMAIL=

# =============================================================================
# Branding Configuration
# =============================================================================

# Brand identifier for the application (affects styling and branding)
# Supported values: warp, seb
# Example: warp
BRAND=

# =============================================================================
# TLS/SSL Certificate Configuration
# =============================================================================

# Staging Certbot domain. Production Compose expects externally managed certs.
# Example: remote-access.example.com
SERVICEDOMAIN=

# Staging Certbot email for Let's Encrypt certificate notifications
# Example: admin@example.com
EMAIL=

# Path to the TLS/SSL certificate file (fullchain.pem)
# Example: /certs/live/remote-access.example.com/fullchain.pem
TLS_CERT_PATH=

# Path to the TLS/SSL private key file (privkey.pem)
# Example: /certs/live/remote-access.example.com/privkey.pem
TLS_KEY_PATH=

# =============================================================================
# Network Configuration
# =============================================================================

# IP address of the UDP forwarding host (used for ESP32 device communication)
# Use 0.0.0.0 when there is no forwarding host.
# Example: 192.168.1.100
FORWARD_HOST=

# Additional host entries to add to container's /etc/hosts file
# Compose always adds this entry: provide a valid mapping rather than empty.
# Format: hostname:ip_address (or hostname:host-gateway)
# Example: myhost.local:192.168.1.50
EXTRA_HOSTS=

# Host interface to publish Adminer on (production/staging Compose)
# Example: 127.0.0.1
ADMINER_IP=

# Optional numeric backend user/group (Compose defaults to 1000:1000).
# Ensure certificate readability and /logs write permissions for this user.
# UID=1000
# GID=1000

# Optional staging build arguments (defaults to 1000).
# USER_ID=1000
# GROUP_ID=1000
