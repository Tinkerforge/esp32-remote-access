# Required backend settings. Paths are relative to the backend working directory.
# See README.rst for the complete environment reference.
DATABASE_URL=
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
EMAIL_RELAY=
# SmtpTransport::relay uses implicit TLS (usually port 465).
EMAIL_RELAY_PORT=
# Full public HTTPS origin, including the port for local development; no trailing slash.
FRONTEND_URL=
SENDER_EMAIL=
SENDER_NAME=
# Debug-only firmware checkout path; release builds always use /static.
WARP_CHARGER_GIT_PATH=
# Example when starting from backend/: ../frontend/dist
STATIC_FILES_DIR=
TLS_CERT_PATH=
TLS_KEY_PATH=

# UDP forwarding host IPv4 address; use 0.0.0.0 when there is none.
FORWARD_HOST=0.0.0.0
# Runtime email branding; frontend branding is set at build time.
BRAND=warp
# Optional: returned verbatim by the unauthenticated /api/auth/service_token route.
# Leave unset/empty to return HTTP 500 from that endpoint.
OPTIONAL_SERVICE_AUTH_TOKEN=
# Optional daily statistics mail. Unset either variable to disable it.
# SERVER_NAME=
# MONITORING_EMAIL=
